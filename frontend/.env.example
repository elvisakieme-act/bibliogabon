VITE_API_BASE_URL=http://127.0.0.1:8000

# Serveur de developpement Vite. Valeurs par defaut : 127.0.0.1:5173 et aucun
# hote externe autorise. A renseigner uniquement derriere un proxy distant
# (studio cloud, tunnel), par exemple :
#   VITE_DEV_HOST=0.0.0.0
#   VITE_DEV_PORT=5174
#   VITE_DEV_ALLOWED_HOSTS=5174-mon-espace.exemple.dev

# Derrière un proxy de développement en nuage, faire relayer l'API par Vite
# plutôt que d'appeler un autre hôte : le préliminaire CORS disparaît, et
# avec lui la liste de méthodes que le proxy impose (celui de Lightning
# n'autorise pas PATCH). Pointer alors VITE_API_BASE_URL sur l'hôte du
# frontend lui-même.
#   VITE_DEV_API_PROXY=http://127.0.0.1:8002

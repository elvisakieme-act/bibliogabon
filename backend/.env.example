DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_LOG_LEVEL=INFO
DATABASE_URL=postgres://bibliogabon:bibliogabon@localhost:5432/bibliogabon
DOCUMENT_STORAGE_BUCKET=bibliogabon-private-documents
DOCUMENT_STORAGE_KEY_PREFIX=documents
READER_SESSION_TTL_MINUTES=120

# --- Ingestion pillar --------------------------------------------------------
# Message broker for the Celery workers. Required in production.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Run tasks inline instead of dispatching them. Defaults to True outside
# production, so the test suite needs no broker.
CELERY_TASK_ALWAYS_EAGER=True

# Private document storage: "filesystem" for local development, "s3" for any
# S3-compatible provider. Production must use s3.
DOCUMENT_STORAGE_BACKEND=filesystem
DOCUMENT_STORAGE_ENDPOINT_URL=
DOCUMENT_STORAGE_ACCESS_KEY=
DOCUMENT_STORAGE_SECRET_KEY=
# boto3 requires a region even when the provider ignores it.
DOCUMENT_STORAGE_REGION=us-east-1

# Page rendering and OCR.
DOCUMENT_PAGE_IMAGE_WIDTH=1240
OCR_LANGUAGES=fra
OCR_MIN_CHARACTERS=20

# Ce fichier est lu au démarrage. Une vraie variable d'environnement
# l'emporte toujours sur ce qui est écrit ici.
#
# DJANGO_ENV_FILE désigne un autre fichier ; vide, il n'en charge aucun —
# utile quand la configuration vient entièrement d'un orchestrateur.
#
# DJANGO_SECRET_KEY doit faire au moins 32 octets : elle signe les JWT.

DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_LOG_LEVEL=INFO
# Le développement tourne sur PostgreSQL, comme la production.
#
# SQLite fonctionne encore pour une vérification rapide, mais le lecteur
# tuilé s'y casse : OpenSeadragon demande des dizaines d'images en parallèle
# et SQLite verrouille la base entière à chaque écriture. Le symptôme est une
# erreur 500 sur une tuile, ce qui envoie la recherche du défaut vers le
# tuilage — qui n'y est pour rien. Une course entre deux requêtes y est de
# plus invisible, le verrou les sérialisant.
#
#   sudo apt-get install postgresql
#   sudo -u postgres createuser --createdb --pwprompt bibliogabon
#   sudo -u postgres createdb -O bibliogabon bibliogabon
DATABASE_URL=postgres://bibliogabon:bibliogabon@localhost:5432/bibliogabon
DOCUMENT_STORAGE_BUCKET=bibliogabon-private-documents
DOCUMENT_STORAGE_KEY_PREFIX=documents
READER_SESSION_TTL_MINUTES=120

# --- Ingestion pillar --------------------------------------------------------
# Message broker for the Celery workers. Required in production.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Run tasks inline instead of dispatching them. Defaults to True outside
# production, so the test suite needs no broker.
CELERY_TASK_ALWAYS_EAGER=True

# Private document storage: "filesystem" for local development, "s3" for any
# S3-compatible provider. Production must use s3.
DOCUMENT_STORAGE_BACKEND=filesystem
DOCUMENT_STORAGE_ENDPOINT_URL=
DOCUMENT_STORAGE_ACCESS_KEY=
DOCUMENT_STORAGE_SECRET_KEY=
# boto3 requires a region even when the provider ignores it.
DOCUMENT_STORAGE_REGION=us-east-1

# Page rendering and OCR.
DOCUMENT_PAGE_IMAGE_WIDTH=1240
OCR_LANGUAGES=fra
OCR_MIN_CHARACTERS=20

# Dépôt de fichiers sources (200 Mo par défaut).
DOCUMENT_UPLOAD_MAX_BYTES=209715200
DOCUMENT_UPLOAD_ACCEPTED_MIME_TYPES=application/pdf

# Adresse publique de l'API, quand elle diffère de celle que Django voit.
#
# Le manifeste IIIF du lecteur annonce des adresses absolues — la
# spécification les exige — et le visualiseur construit toutes ses requêtes à
# partir d'elles. Derrière un proxy inverse, l'adresse déduite de la requête
# est l'adresse interne : le manifeste s'affiche normalement et pas une seule
# page ne charge, ce qui envoie la recherche du défaut vers le tuilage, qui
# n'y est pour rien.
#
# Vide en accès direct et en développement.
DJANGO_PUBLIC_API_BASE_URL=
